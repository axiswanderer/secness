{
  "name": "@secness/sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "C5: sandbox orchestrator and isolation baseline",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docker": "vitest run --config vitest.docker.config.ts"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "@secness/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2"
  }
}
